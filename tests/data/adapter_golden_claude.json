{
  "claude": {
    "direct_folder_no_exec": [
      "-p"
    ],
    "direct_folder_plain": [
      "exec",
      "-",
      "--json"
    ],
    "direct_folder_with_skip": [
      "exec",
      "--skip-git-repo-check"
    ],
    "full_access_args": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--permission-mode",
      "bypassPermissions"
    ],
    "invocation": {
      "args": [
        "-p",
        "--output-format",
        "stream-json",
        "--verbose"
      ],
      "executable": "claude",
      "input": "stdin"
    },
    "invocation_bad_session": {
      "error": "invalid explicit session ID"
    },
    "invocation_resume": {
      "args": [
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--resume",
        "sess-1"
      ],
      "executable": "claude",
      "input": "stdin"
    },
    "session_full_access_bad_model": {
      "error": "model must belong to an observed CLI catalog"
    },
    "session_full_access_bad_session": {
      "error": "invalid explicit session ID"
    },
    "session_full_access_both": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--permission-mode",
      "bypassPermissions",
      "--model",
      "m1",
      "--resume",
      "sess-1"
    ],
    "session_full_access_model": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--permission-mode",
      "bypassPermissions",
      "--model",
      "m1"
    ],
    "session_full_access_none": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--permission-mode",
      "bypassPermissions"
    ],
    "session_full_access_session": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--permission-mode",
      "bypassPermissions",
      "--resume",
      "sess-1"
    ],
    "session_initial_bad_model": {
      "error": "model must belong to an observed CLI catalog"
    },
    "session_initial_bad_session": {
      "error": "invalid explicit session ID"
    },
    "session_initial_both": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--model",
      "m1",
      "--resume",
      "sess-1"
    ],
    "session_initial_model": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--model",
      "m1"
    ],
    "session_initial_none": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose"
    ],
    "session_initial_session": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--resume",
      "sess-1"
    ]
  }
}
