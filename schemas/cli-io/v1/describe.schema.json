{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentconductor:cli-io:1:describe",
  "title": "acio.describe/1 - the one JSON document printed by `<cli> --acio-describe` (exit 0 within 5 seconds); capabilities and invocation have exactly the shape of acio.agent/1",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "acio",
    "capabilities",
    "invocation"
  ],
  "properties": {
    "schema": {
      "const": "acio.describe/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "vendor": {
      "type": "string"
    },
    "acio": {
      "type": "object",
      "required": [
        "versions"
      ],
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "read_only",
        "streaming"
      ],
      "properties": {
        "read_only": {
          "type": "boolean",
          "description": "Honors mode=ask without changing the workspace."
        },
        "workspace_write": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean",
          "description": "Emits message deltas."
        },
        "resume": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "response_schema": {
          "type": "boolean",
          "description": "Honors input.response_schema."
        },
        "heartbeat_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Longest silence between events."
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "traits": {
                "type": "object",
                "properties": {
                  "reasoning": {
                    "type": "boolean"
                  },
                  "efforts": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max"
                      ]
                    },
                    "uniqueItems": true,
                    "description": "Effort levels the model honors. Empty or absent: the model has no effort setting."
                  },
                  "context_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "structured_output": {
                    "type": "boolean"
                  },
                  "best_for": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "extract",
                        "summarize",
                        "analyze",
                        "code",
                        "agentic",
                        "creative"
                      ]
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "task_types": {
          "type": "array",
          "items": {
            "enum": [
              "extract",
              "summarize",
              "analyze",
              "code",
              "agentic",
              "creative"
            ]
          },
          "uniqueItems": true,
          "description": "Task types the CLI accepts. Absent means all."
        },
        "task_defaults": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "extract",
              "summarize",
              "analyze",
              "code",
              "agentic",
              "creative"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string"
              },
              "effort": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            },
            "additionalProperties": false
          },
          "description": "The CLI's own recommended model and effort per task type."
        },
        "control": {
          "type": "object",
          "properties": {
            "cancel": {
              "type": "boolean"
            },
            "user_message": {
              "type": "boolean",
              "description": "Accepts a user_message while running."
            },
            "tool_decision": {
              "type": "boolean",
              "description": "Waits for tool_decision on tool requests with needs_decision."
            }
          },
          "additionalProperties": false,
          "description": "Which acio.control messages the CLI honors. Absent or all false: stdin is closed after the input document and only signals cancel."
        }
      },
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "required": [
        "input"
      ],
      "properties": {
        "input": {
          "enum": [
            "stdin",
            "file"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fixed arguments for a plain run. Placeholders: {model}, {session_id}, {task_file}."
        },
        "control_args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Arguments added when control.enabled is true (for example a streaming-input flag)."
        },
        "session": {
          "type": "object",
          "properties": {
            "model_args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Appended when a model is chosen; {model}."
            },
            "resume": {
              "type": "object",
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "append",
                    "replace_argv"
                  ]
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "full_access_argv": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "bare_argv": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "replace_argv only: the argv of a resumed run composed without the initial-only options (used by the plain invocation builder)."
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "append"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "args"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "replace_argv"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "argv"
                    ]
                  }
                }
              ],
              "description": "append: add args ({session_id}) to the argv. replace_argv: the whole argv for a resumed run (some CLIs take resume as a subcommand)."
            },
            "model_aliases": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Other spellings of the model flag that make a profile ambiguous (for example -m)."
            },
            "selectors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Session selector flags that make a profile ambiguous when a session is added."
            }
          },
          "additionalProperties": false
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              },
              "model_values": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "description": "Named option groups such as effort; the same shape as execution_options. {value}."
        },
        "response_schema": {
          "type": "object",
          "properties": {
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "{schema_json}: the schema inline."
            },
            "file_args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "{schema_file}: a file the supervisor writes."
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "control": {
          "type": "object",
          "properties": {
            "cancel": {
              "type": "object",
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "control_line",
                    "signal"
                  ]
                }
              },
              "additionalProperties": false
            },
            "user_message": {
              "type": "object",
              "required": [
                "encoding"
              ],
              "properties": {
                "encoding": {
                  "enum": [
                    "acio_control",
                    "stream_json_user",
                    "none"
                  ]
                }
              },
              "additionalProperties": false
            },
            "tool_decision": {
              "type": "object",
              "required": [
                "encoding"
              ],
              "properties": {
                "encoding": {
                  "enum": [
                    "acio_control",
                    "permission_prompt_tool",
                    "none"
                  ]
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "unless": {
                  "enum": [
                    "full_access"
                  ],
                  "description": "The capability is off when the profile has this property (the default profile is full access)."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "description": "The command name a profile starts from when none is registered (for example codex)."
        },
        "full_access": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "append",
                "replace_argv"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "append"
                  }
                }
              },
              "then": {
                "required": [
                  "args"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "replace_argv"
                  }
                }
              },
              "then": {
                "required": [
                  "argv"
                ]
              }
            }
          ],
          "description": "How the arguments change when the operator's profile is full access: append args to the plain argv, or replace the whole argv."
        },
        "direct_folder": {
          "type": "object",
          "required": [
            "after",
            "args"
          ],
          "properties": {
            "after": {
              "type": "string",
              "minLength": 1,
              "description": "The argument the extra arguments are inserted after."
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skip_if_present": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_anchor_message": {
              "type": "string",
              "description": "UI message id used when the anchor argument is absent."
            }
          },
          "additionalProperties": false,
          "description": "Extra arguments for a project folder that is not a Git repository."
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-[a-z0-9-]+$": {}
  },
  "additionalProperties": false
}
