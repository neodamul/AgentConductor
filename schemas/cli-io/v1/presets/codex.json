{
  "schema": "acio.agent/1",
  "preset": "codex",
  "capabilities": {
    "read_only": true,
    "workspace_write": true,
    "streaming": false,
    "resume": true,
    "tools": true,
    "response_schema": true,
    "heartbeat_seconds": 60,
    "languages": [
      "ko",
      "en"
    ],
    "task_types": [
      "extract",
      "summarize",
      "analyze",
      "code",
      "agentic",
      "creative"
    ],
    "control": {
      "cancel": false,
      "user_message": false,
      "tool_decision": false
    },
    "task_defaults": {
      "extract": {
        "effort": "low"
      },
      "summarize": {
        "effort": "medium"
      },
      "analyze": {
        "effort": "medium"
      },
      "code": {
        "effort": "high"
      },
      "agentic": {
        "effort": "high"
      },
      "creative": {
        "effort": "medium"
      }
    }
  },
  "invocation": {
    "input": "stdin",
    "args": [
      "exec",
      "--sandbox",
      "workspace-write",
      "-",
      "--json"
    ],
    "full_access_args": [
      "--dangerously-bypass-approvals-and-sandbox"
    ],
    "session": {
      "model_args": [
        "--model",
        "{model}"
      ],
      "resume": {
        "mode": "replace_argv",
        "argv": [
          "exec",
          "--sandbox",
          "workspace-write",
          "resume",
          "{session_id}",
          "-",
          "--json"
        ],
        "full_access_argv": [
          "exec",
          "--dangerously-bypass-approvals-and-sandbox",
          "resume",
          "{session_id}",
          "-",
          "--json"
        ]
      }
    },
    "options": {
      "effort": {
        "args": [
          "-c",
          "model_reasoning_effort=\"{value}\""
        ],
        "values": [
          "low",
          "medium",
          "high"
        ],
        "default": "medium"
      }
    },
    "response_schema": {
      "file_args": [
        "--output-schema",
        "{schema_file}"
      ]
    },
    "control": {
      "cancel": {
        "mode": "signal"
      },
      "user_message": {
        "encoding": "none"
      },
      "tool_decision": {
        "encoding": "none"
      }
    }
  }
}
